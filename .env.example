# Copy to .env for local (non-Docker) development. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://newtonite:newtonite@localhost:5432/newtonite
TEST_DATABASE_URL=postgres://newtonite:newtonite@localhost:5432/newtonite_test
# Local development secret only. Use a long random value anywhere else.
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=10
WORKER_POLL_MS=2000
